# Required in production.
APP_ENV=production
SESSION_SECRET=replace-with-at-least-48-random-bytes
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
OAUTH_CALLBACK_URL=https://reports.example/auth/github/callback

# Comma-separated addresses/networks allowed to set X-Forwarded-* headers.
# Use the values documented by the selected hosting provider.
TRUSTED_PROXY_HOSTS=127.0.0.1,::1
SESSION_HTTPS_ONLY=true

# Replace the defaults if a different moderation team is required.
APPDB_ADMIN_GITHUB_LOGINS=joewebkid,timofeylednev,j92580498-max,makaherpasswordlostmedia
REPORTS_PER_USER_PER_HOUR=10
SEED_DEMO_DATA=false

# Recommended in production. New uploaded screenshots are stored in this
# database; without it the app falls back to local SQLite.
# DATABASE_URL=postgresql+psycopg://user:password@host/database

# Optional patch-submission gateway configuration.
# PATCH_SUBMISSION_GITHUB_TOKEN=server-only-token
# PATCH_SUBMISSION_REPOSITORY=joewebkid/SuperDuperPatches
# PATCH_SUBMISSION_RATE_SALT=replace-with-random-secret
